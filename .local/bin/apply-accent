#!/usr/bin/env python3
"""Recolor Rofi and Alacritty from one accent color: apply-accent '#RRGGBB'"""
import re, sys
from pathlib import Path

H = Path.home()
accent = sys.argv[1].upper() if len(sys.argv) > 1 else ""
if not re.fullmatch(r"#[0-9A-F]{6}", accent):
    sys.exit("usage: apply-accent '#RRGGBB'")

def rgb(h): return [int(h[i:i + 2], 16) for i in (1, 3, 5)]
def hexc(c): return "#%02X%02X%02X" % tuple(c)
def mix(a, b, t): return hexc([round(x * t + y * (1 - t)) for x, y in zip(rgb(a), rgb(b))])
def on(h):
    r, g, b = rgb(h)
    return "#0B1118" if 0.299 * r + 0.587 * g + 0.114 * b > 150 else "#FFFFFF"

# Alacritty: only the colors that follow the wallpaper
bg = mix(accent, "#111318", 0.0)
f = H / ".config/alacritty/wallpaper-colors.toml"
f.parent.mkdir(parents=True, exist_ok=True)
f.write_text(
    '[colors.primary]\n'
    f'background = "{bg}"\n'
    'foreground = "#E8EAF0"\n\n'
    '[colors.cursor]\n'
    f'text = "{bg}"\n'
    'cursor = "#E8EAF0"\n\n'
    '[colors.selection]\n'
    f'text = "{on(accent)}"\n'
    f'background = "{accent}"\n'
)

# Rofi: change only "accent: #hex;" lines, back up each file once
for name in ("theme-colors.rasi", "ios-spotlight.rasi", "wallpaper-picker.rasi"):
    p = H / ".config/rofi" / name
    if not p.is_file():
        continue
    t = p.read_text()
    new = re.sub(r"(\baccent:\s*)#[0-9A-Fa-f]{6,8}(\s*;)",
                 lambda m: m.group(1) + accent + m.group(2), t)
    if new != t:
        b = p.with_name(p.name + ".backup-before-accent")
        if not b.exists():
            b.write_text(t)
        p.write_text(new)
