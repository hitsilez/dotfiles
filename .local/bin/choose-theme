#!/usr/bin/env bash
set -euo pipefail

THEME_SCRIPT="/home/tsilez/.config/themes/switch-theme.sh"

CHOICE="$(
  printf '%s\n' Christian Motivational Sci-Fi |
    rofi -dmenu -i \
      -p "Choose Theme" \
      -theme-str 'window { width: 360px; }'
)" || exit 0

[[ -n "$CHOICE" ]] || exit 0

exec "$THEME_SCRIPT" "$CHOICE"
