@import "/home/tsiles/.config/rofi/colors.rasi"
configuration {
  modi: "drun";
  show-icons: true;
  display-drun: "Apps";
  drun-display-format: "{name}";
  font: "sans 12";
}
* {
  background-color: transparent;
  text-color: @fg;
}
window {
  width: 560px;
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 12px;
  padding: 16px;
}
mainbox { spacing: 12px; children: [inputbar, listview]; }
inputbar {
  background-color: @bg-alt;
  border-radius: 8px;
  padding: 10px 14px;
  spacing: 8px;
  children: [prompt, entry];
}
prompt { text-color: @accent; }
entry { placeholder: "Search applications..."; placeholder-color: @muted; }
listview { lines: 8; columns: 1; spacing: 4px; fixed-height: true; scrollbar: false; }
element { padding: 8px 12px; border-radius: 8px; spacing: 10px; }
element selected { background-color: @accent; text-color: @on-accent; }
element-icon { size: 24px; }
element-text { vertical-align: 0.5; text-color: inherit; }
