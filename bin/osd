#!/usr/bin/env bash
case "$1 $2" in
  "volume up")       wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  "volume down")     wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  "volume mute")     wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  "brightness up")   brightnessctl -e4 -n2 set 5%+ > /dev/null ;;
  "brightness down") brightnessctl -e4 -n2 set 5%- > /dev/null ;;
esac

case "$1" in
  volume)
    out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
    vol=$(echo "$out" | awk '{printf "%d", $2*100}')
    if echo "$out" | grep -q MUTED; then label="Volume: muted"; else label="Volume: ${vol}%"; fi
    notify-send -t 1500 -h string:x-canonical-private-synchronous:osd -h int:value:"$vol" "$label"
    ;;
  brightness)
    pct=$(( $(brightnessctl get) * 100 / $(brightnessctl max) ))
    notify-send -t 1500 -h string:x-canonical-private-synchronous:osd -h int:value:"$pct" "Brightness: ${pct}%"
    ;;
esac
