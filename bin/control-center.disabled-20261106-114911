#!/usr/bin/env python3
import gi
import subprocess
import re

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

def run(args):
    try:
        return subprocess.run(
            args, capture_output=True, text=True, timeout=4
        ).stdout.strip()
    except Exception:
        return ""

def action(args):
    try:
        subprocess.Popen(args, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except Exception:
        pass

CSS = b"""
window {
    background: #151923;
    color: #f4f6ff;
}
.title {
    font-size: 23px;
    font-weight: bold;
    color: #f4f6ff;
}
.subtitle {
    color: #929db5;
    font-size: 11px;
}
.tile {
    background: #252d40;
    border: 1px solid #343f58;
    border-radius: 18px;
    padding: 14px;
    color: #f4f6ff;
}
.tile:checked, .tile.active {
    background: #344d7c;
    border-color: #789aff;
}
.tile:hover {
    background: #394664;
}
.tile-title {
    font-weight: bold;
    font-size: 13px;
}
.tile-status {
    color: #b5c4e8;
    font-size: 10px;
}
.card {
    background: #202737;
    border: 1px solid #303b51;
    border-radius: 18px;
    padding: 15px;
}
.section-title {
    font-weight: bold;
    font-size: 13px;
}
scale trough {
    background: #394258;
    min-height: 7px;
    border-radius: 8px;
}
scale highlight {
    background: #8199ff;
    border-radius: 8px;
}
scale slider {
    background: #ffffff;
    min-width: 17px;
    min-height: 17px;
    border-radius: 12px;
}
button {
    color: #f4f6ff;
}
.media-button {
    background: #303b53;
    border-radius: 14px;
    padding: 9px;
}
.close-button {
    background: #252d40;
    border-radius: 12px;
    padding: 8px;
}
"""

provider = Gtk.CssProvider()
provider.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), provider,
    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
)

class ControlCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Midnight Control Center")
        self.set_default_size(410, 540)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_border_width(18)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=13)
        self.add(root)

        header = Gtk.Box(spacing=8)
        heading = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        title = Gtk.Label(label="Control Center", xalign=0)
        title.get_style_context().add_class("title")
        subtitle = Gtk.Label(label="Your device, your way", xalign=0)
        subtitle.get_style_context().add_class("subtitle")
        heading.pack_start(title, False, False, 0)
        heading.pack_start(subtitle, False, False, 0)
        header.pack_start(heading, True, True, 0)
        root.pack_start(header, False, False, 2)

        tiles = Gtk.Grid()
        tiles.set_column_spacing(12)
        tiles.set_row_spacing(12)
        root.pack_start(tiles, False, False, 0)

        self.wifi = self.make_tile("network-wireless-symbolic", "Wi-Fi")
        self.bt = self.make_tile("bluetooth-active-symbolic", "Bluetooth")
        tiles.attach(self.wifi, 0, 0, 1, 1)
        tiles.attach(self.bt, 1, 0, 1, 1)

        self.wifi.connect("clicked", lambda *_: action(["nm-connection-editor"]))
        self.bt.connect("clicked", lambda *_: action(["blueman-manager"]))

        bt_manager = Gtk.Button(label="Bluetooth devices  ↗")
        bt_manager.get_style_context().add_class("media-button")
        bt_manager.connect("clicked",
                           lambda *_: action(["blueman-manager"]))
        root.pack_start(bt_manager, False, False, 0)

        root.pack_start(self.make_slider_card(
            "Brightness", "display-brightness-symbolic",
            self.get_brightness, self.set_brightness
        ), False, False, 0)

        root.pack_start(self.make_slider_card(
            "Volume", "audio-volume-high-symbolic",
            self.get_volume, self.set_volume
        ), False, False, 0)

        media = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        media.get_style_context().add_class("card")

        media_header = Gtk.Box(spacing=8)
        media_icon = Gtk.Image.new_from_icon_name(
            "audio-x-generic-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
        media_title = Gtk.Label(label="Now Playing", xalign=0)
        media_title.get_style_context().add_class("section-title")
        media_header.pack_start(media_icon, False, False, 0)
        media_header.pack_start(media_title, True, True, 0)
        media.pack_start(media_header, False, False, 0)

        self.track = Gtk.Label(label="No media playing", xalign=0)
        self.track.get_style_context().add_class("subtitle")
        media.pack_start(self.track, False, False, 0)

        controls = Gtk.Box(spacing=12)
        controls.set_halign(Gtk.Align.CENTER)

        for icon, command in [
            ("media-skip-backward-symbolic", ["playerctl", "previous"]),
            ("media-playback-start-symbolic", ["playerctl", "play-pause"]),
            ("media-skip-forward-symbolic", ["playerctl", "next"])
        ]:
            button = Gtk.Button()
            button.set_image(Gtk.Image.new_from_icon_name(
                icon, Gtk.IconSize.BUTTON))
            button.get_style_context().add_class("media-button")
            button.connect("clicked", lambda _, c=command: action(c))
            controls.pack_start(button, False, False, 0)

        media.pack_start(controls, False, False, 0)
        root.pack_start(media, False, False, 0)

        close = Gtk.Button(label="Close")
        close.get_style_context().add_class("close-button")
        close.connect("clicked", lambda *_: Gtk.main_quit())
        root.pack_start(close, False, False, 0)

        self.refresh()
        GLib.timeout_add_seconds(3, self.refresh)

    def make_tile(self, icon, name):
        button = Gtk.ToggleButton()
        button.set_size_request(175, 90)
        button.get_style_context().add_class("tile")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
        label = Gtk.Label(label=name)
        label.get_style_context().add_class("tile-title")
        status = Gtk.Label(label="Checking...")
        status.get_style_context().add_class("tile-status")
        box.pack_start(image, False, False, 0)
        box.pack_start(label, False, False, 0)
        box.pack_start(status, False, False, 0)
        button.add(box)
        button.status_label = status
        return button

    def make_slider_card(self, name, icon, getter, setter):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("card")
        heading = Gtk.Box(spacing=8)
        image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
        label = Gtk.Label(label=name, xalign=0)
        label.get_style_context().add_class("section-title")
        heading.pack_start(image, False, False, 0)
        heading.pack_start(label, True, True, 0)
        card.pack_start(heading, False, False, 0)

        scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_draw_value(True)
        scale.set_value(getter())
        scale.connect("value-changed",
                      lambda widget: setter(widget.get_value()))
        card.pack_start(scale, False, False, 0)
        if name == "Brightness":
            self.brightness_scale = scale
        else:
            self.volume_scale = scale
        return card

    def get_brightness(self):
        out = run(["brightnessctl", "-m"])
        try:
            return float(out.split(",")[3].replace("%", ""))
        except Exception:
            return 50

    def set_brightness(self, value):
        action(["brightnessctl", "set", f"{int(value)}%"])

    def get_volume(self):
        out = run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        match = re.search(r"Volume:\s*([\d.]+)", out)
        return float(match.group(1)) * 100 if match else 50

    def set_volume(self, value):
        action(["wpctl", "set-volume", "-l", "1",
                "@DEFAULT_AUDIO_SINK@", f"{int(value)}%"])

    def toggle_wifi(self, *_):
        enabled = "enabled" in run(["nmcli", "radio", "wifi"])
        action(["nmcli", "radio", "wifi", "off" if enabled else "on"])
        GLib.timeout_add(700, self.refresh)

    def toggle_bt(self, *_):
        powered = "Powered: yes" in run(["bluetoothctl", "show"])
        action(["bluetoothctl", "power", "off" if powered else "on"])
        GLib.timeout_add(700, self.refresh)

    def refresh(self):
        wifi = "enabled" in run(["nmcli", "radio", "wifi"])
        bt = "Powered: yes" in run(["bluetoothctl", "show"])

        self.wifi.set_active(wifi)
        self.bt.set_active(bt)
        self.wifi.status_label.set_text("On" if wifi else "Off")
        self.bt.status_label.set_text("On" if bt else "Off")

        track = run(["playerctl", "metadata", "--format",
                     "{{ artist }} — {{ title }}"])
        self.track.set_text(track if track else "No media playing")
        return True

app = ControlCenter()
app.connect("destroy", Gtk.main_quit)
app.show_all()
Gtk.main()
