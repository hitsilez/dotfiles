{
  "layer": "top",
  "position": "top",
  "height": 26,
  "margin-top": 4,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,

  "modules-left": ["custom/logo", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["group/stats", "network", "bluetooth", "backlight", "pulseaudio", "battery", "custom/power"],

  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "on-click": "$HOME/.local/bin/power-menu"
  },
  "custom/logo": {
    "format": "\uf303",
    "tooltip": false,
    "on-click": "pkill wofi || wofi --show drun"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "group/stats": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "click-to-reveal": true,
      "transition-left-to-right": true
    },
    "modules": ["custom/arrow", "cpu", "memory", "disk"]
  },
  "custom/arrow": {
    "format": "\uf105",
    "tooltip": false
  },
  "cpu": {
    "interval": 2,
    "format": "\uf2db {usage}%"
  },
  "memory": {
    "interval": 5,
    "format": "\uf538 {percentage}%"
  },
  "disk": {
    "interval": 30,
    "path": "/",
    "format": "\uf0a0 {percentage_used}%"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"],
    "format-ethernet": "\uf1e6",
    "format-disconnected": "\udb82\udd2d",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "on-click": "$HOME/.local/bin/wifi-menu"
  },
  "bluetooth": {
    "format": "\uf293",
    "format-off": "\uf293 off",
    "format-connected": "\uf293 {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "$HOME/.local/bin/bluetooth-menu"
  },
  "backlight": {
    "format": "\uf185 {percent}%"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\uf026 muted",
    "format-icons": { "default": ["\uf027", "\uf028"] }
  },
  "battery": {
    "interval": 2,
    "states": { "warning": 20, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "\uf0e7 {capacity}%",
    "format-plugged": "\uf1e6 {capacity}%",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"]
  }
}
